@using System.Globalization
@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var langLabel = currentCulture switch { "kk" => "Қазақша", "en" => "English", _ => "Русский" };
    var langFlag  = currentCulture switch { "kk" => "🇰🇿", "en" => "🇬🇧", _ => "🇷🇺" };
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Z.ON</title>
    <meta name="description" content="Z.ON — @L["Hero.Sub"]" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>

    <!-- NAVBAR -->
    <nav class="fc-navbar fixed-top" id="mainNav">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between w-100">
                <a class="fc-logo text-decoration-none d-flex align-items-center gap-2" href="/">
                    <div class="fc-logo-icon">
                        <i class="bi bi-hexagon-fill"></i>
                    </div>
                    <span class="fc-logo-text">Z.<span class="text-primary">ON</span></span>
                </a>

                <button class="navbar-toggler border-0 d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <i class="bi bi-list fs-4 text-dark"></i>
                </button>

                <div class="collapse navbar-collapse d-lg-flex align-items-center justify-content-center flex-grow-1" id="navMenu">
                    <ul class="list-unstyled d-flex flex-column flex-lg-row align-items-start align-items-lg-center gap-1 mb-0 mx-auto">
                        <li class="dropdown">
                            <a class="fc-nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">@L["Nav.Products"]</a>
                            <div class="dropdown-menu fc-dropdown shadow-lg border-0 p-3" style="min-width:280px">
                                <a class="fc-drop-item d-flex align-items-center gap-3 rounded-3 p-2 mb-1" href="/Products">
                                    <span class="fc-drop-icon" style="background:rgba(59,130,246,0.1);color:#3B82F6"><i class="bi bi-box-seam-fill"></i></span>
                                    <div><div class="fw-semibold small">Z.ON Pro</div><div class="text-muted" style="font-size:0.75rem">@L["Nav.Pro.Desc"]</div></div>
                                </a>
                                <a class="fc-drop-item d-flex align-items-center gap-3 rounded-3 p-2 mb-1" href="/Products#business">
                                    <span class="fc-drop-icon" style="background:rgba(16,185,129,0.1);color:#10B981"><i class="bi bi-buildings-fill"></i></span>
                                    <div><div class="fw-semibold small">Z.ON Business</div><div class="text-muted" style="font-size:0.75rem">@L["Nav.Business.Desc"]</div></div>
                                </a>
                                <a class="fc-drop-item d-flex align-items-center gap-3 rounded-3 p-2 mb-1" href="/Products#edo">
                                    <span class="fc-drop-icon" style="background:rgba(245,158,11,0.1);color:#F59E0B"><i class="bi bi-file-earmark-text-fill"></i></span>
                                    <div><div class="fw-semibold small">Z.ON ЭДО</div><div class="text-muted" style="font-size:0.75rem">@L["Nav.Edo.Desc"]</div></div>
                                </a>
                                <a class="fc-drop-item d-flex align-items-center gap-3 rounded-3 p-2" href="/Products#ai">
                                    <span class="fc-drop-icon" style="background:rgba(139,92,246,0.1);color:#8B5CF6"><i class="bi bi-stars"></i></span>
                                    <div>
                                        <div class="fw-semibold small d-flex align-items-center gap-2">Z.ON AI <span class="badge text-bg-primary" style="font-size:0.6rem">New</span></div>
                                        <div class="text-muted" style="font-size:0.75rem">@L["Nav.Ai.Desc"]</div>
                                    </div>
                                </a>
                            </div>
                        </li>
                        <li><a class="fc-nav-link" href="/About">@L["Nav.About"]</a></li>
                        <li><a class="fc-nav-link" href="/#faq">@L["Nav.FAQ"]</a></li>
                        <li><a class="fc-nav-link" href="/Contacts">@L["Nav.Contacts"]</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                        <!-- Language Switcher -->
                        <div class="dropdown fc-lang-switcher">
                            <button class="btn fc-btn-lang dropdown-toggle" data-bs-toggle="dropdown">
                                <span>@langFlag</span> @langLabel
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end fc-dropdown border-0 shadow-lg p-2" style="min-width:160px">
                                <li>
                                    <a class="fc-drop-item rounded-2 p-2 d-flex align-items-center gap-2 @(currentCulture=="ru"?"fc-lang-active":"")"
                                       href="/set-culture/ru?returnUrl=@Uri.EscapeDataString(returnUrl)">
                                        🇷🇺 <span class="small">Русский</span>
                                        @if(currentCulture=="ru"){<i class="bi bi-check2 ms-auto text-primary"></i>}
                                    </a>
                                </li>
                                <li>
                                    <a class="fc-drop-item rounded-2 p-2 d-flex align-items-center gap-2 @(currentCulture=="kk"?"fc-lang-active":"")"
                                       href="/set-culture/kk?returnUrl=@Uri.EscapeDataString(returnUrl)">
                                        🇰🇿 <span class="small">Қазақша</span>
                                        @if(currentCulture=="kk"){<i class="bi bi-check2 ms-auto text-primary"></i>}
                                    </a>
                                </li>
                                <li>
                                    <a class="fc-drop-item rounded-2 p-2 d-flex align-items-center gap-2 @(currentCulture=="en"?"fc-lang-active":"")"
                                       href="/set-culture/en?returnUrl=@Uri.EscapeDataString(returnUrl)">
                                        🇬🇧 <span class="small">English</span>
                                        @if(currentCulture=="en"){<i class="bi bi-check2 ms-auto text-primary"></i>}
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <a href="#" class="btn fc-btn-ghost">@L["Nav.Login"]</a>
                        <a href="/Contacts" class="btn fc-btn-cta">@L["Nav.TryFree"]</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="fc-footer">
        <div class="container">
            <div class="row g-5 mb-5">
                <div class="col-lg-4">
                    <a class="fc-logo text-decoration-none d-flex align-items-center gap-2 mb-4" href="/">
                        <div class="fc-logo-icon"><i class="bi bi-hexagon-fill"></i></div>
                        <span class="fc-logo-text text-white">Z.<span style="color:#60a5fa">ON</span></span>
                    </a>
                    <p class="text-muted small mb-4" style="line-height:1.7">@L["Footer.Desc"]</p>
                    <div class="d-flex gap-2">
                        <a href="#" class="fc-social"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="fc-social"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="fc-social"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="fc-social"><i class="bi bi-telegram"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2 offset-lg-1">
                    <h6 class="text-white fw-semibold mb-4">@L["Footer.Solutions"]</h6>
                    <ul class="list-unstyled fc-footer-links">
                        <li><a href="#">@L["Sol.1.Title"]</a></li>
                        <li><a href="#">@L["Sol.2.Title"]</a></li>
                        <li><a href="#">@L["Sol.3.Title"]</a></li>
                        <li><a href="#">@L["Sol.5.Title"]</a></li>
                        <li><a href="#">@L["Sol.6.Title"]</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="text-white fw-semibold mb-4">@L["Footer.Products"]</h6>
                    <ul class="list-unstyled fc-footer-links">
                        <li><a href="#">Z.ON Pro</a></li>
                        <li><a href="#">Z.ON Business</a></li>
                        <li><a href="#">Z.ON ЭДО</a></li>
                        <li><a href="#">Z.ON AI</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="text-white fw-semibold mb-4">@L["Footer.Company"]</h6>
                    <ul class="list-unstyled fc-footer-links">
                        <li><a href="/About">@L["Nav.About"]</a></li>
                        <li><a href="/#faq">FAQ</a></li>
                        <li><a href="/Contacts">@L["Nav.Contacts"]</a></li>
                        <li><a href="#">@L["Footer.Career"]</a></li>
                    </ul>
                </div>
            </div>
            <div class="fc-footer-bottom">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <span class="text-muted small">@L["Footer.Rights"]</span>
                    <div class="d-flex gap-4">
                        <a href="#" class="text-muted small text-decoration-none fc-policy-link">@L["Footer.Privacy"]</a>
                        <a href="#" class="text-muted small text-decoration-none fc-policy-link">@L["Footer.Offer"]</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/countup.js@2.8.0/dist/countUp.umd.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
