<!-- ===== FAQ ===== -->
<section class="fc-section py-6" id="faq">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="text-center mb-5" data-aos="fade-up">
                    <span class="fc-section-badge"><i class="bi bi-question-circle-fill me-2"></i>@L["Faq.Badge"]</span>
                    <h2 class="fc-section-title mt-3">@L["Faq.Title"]</h2>
                </div>
                <div class="accordion fc-accordion" id="faqAccordion" data-aos="fade-up" data-aos-delay="100">
                    @{
                        var faqs = new[]{
                            (L["Faq.Q1"].Value, L["Faq.A1"].Value),
                            (L["Faq.Q2"].Value, L["Faq.A2"].Value),
                            (L["Faq.Q3"].Value, L["Faq.A3"].Value),
                            (L["Faq.Q4"].Value, L["Faq.A4"].Value),
                        };
                        for (int i = 0; i < faqs.Length; i++)
                        {
                            var (q, a) = faqs[i];
                            <div class="accordion-item fc-acc-item border-0 mb-2">
                                <h2 class="accordion-header">
                                    <button class="accordion-button fc-acc-btn @(i == 0 ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#faq@(i)">
                                        @q
                                    </button>
                                </h2>
                                <div id="faq@(i)" class="accordion-collapse collapse @(i == 0 ? "show" : "")" data-bs-parent="#faqAccordion">
                                    <div class="accordion-body fc-acc-body">@a</div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</section>

