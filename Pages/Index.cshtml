@page
@model IndexModel
@{
    ViewData["Title"] = L["Hero.Title1"].Value;
}

<!-- ===== HERO ===== -->
<section class="fc-hero">
    <div class="fc-hero-bg">
        <div class="fc-orb fc-orb-1"></div>
        <div class="fc-orb fc-orb-2"></div>
    </div>
    <div class="container position-relative">
        <div class="row align-items-center min-vh-100 py-5">
            <div class="col-lg-6 text-center text-lg-start" data-aos="fade-right" data-aos-duration="800">
                <div class="fc-badge mb-4">
                    <i class="bi bi-stars me-2 text-primary"></i>
                    <span>@L["Hero.Badge"]</span>
                </div>
                <h1 class="fc-hero-title">
                    @L["Hero.Title1"]<br>
                    <span class="fc-gradient-text">@L["Hero.Title2"]</span><br>
                    @L["Hero.Title3"]
                </h1>
                <p class="fc-hero-sub mt-4 mb-5">@L["Hero.Sub"]</p>
                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                    <a href="/Contacts" class="btn fc-btn-hero-primary">
                        @L["Hero.Start"] <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                    <a href="#products" class="btn fc-btn-hero-ghost">
                        <i class="bi bi-play-circle me-2"></i>@L["Hero.Demo"]
                    </a>
                </div>
                <div class="fc-hero-trust mt-5 d-flex align-items-center gap-3 justify-content-center justify-content-lg-start">
                    <div class="fc-avatars">
                        <span class="fc-av" style="background:#3B82F6">А</span>
                        <span class="fc-av" style="background:#10B981">Б</span>
                        <span class="fc-av" style="background:#F59E0B">К</span>
                        <span class="fc-av" style="background:#8B5CF6">М</span>
                    </div>
                    <div class="text-start">
                        <div class="fc-stars"><i class="bi bi-star-fill text-warning"></i><i class="bi bi-star-fill text-warning"></i><i class="bi bi-star-fill text-warning"></i><i class="bi bi-star-fill text-warning"></i><i class="bi bi-star-fill text-warning"></i></div>
                        <small class="text-muted">@Html.Raw(L["Hero.Trust"])</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mt-5 mt-lg-0" data-aos="fade-left" data-aos-duration="800" data-aos-delay="200">
                <div class="fc-dashboard-mockup">
                    <div class="fc-mockup-card fc-mockup-main">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="fw-semibold text-dark">Главная</span>
                            <div class="d-flex gap-2">
                                <div style="width:8px;height:8px;border-radius:50%;background:#ef4444"></div>
                                <div style="width:8px;height:8px;border-radius:50%;background:#f59e0b"></div>
                                <div style="width:8px;height:8px;border-radius:50%;background:#10b981"></div>
                            </div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-4">
                                <div class="fc-stat-mini" style="background:rgba(59,130,246,0.08)">
                                    <div class="text-muted" style="font-size:0.65rem">Выручка</div>
                                    <div class="fw-bold text-dark" style="font-size:0.9rem">2 450 000 ₸</div>
                                    <div style="color:#10b981;font-size:0.65rem"><i class="bi bi-arrow-up"></i> 18%</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="fc-stat-mini" style="background:rgba(16,185,129,0.08)">
                                    <div class="text-muted" style="font-size:0.65rem">Налоги</div>
                                    <div class="fw-bold text-dark" style="font-size:0.9rem">245 000 ₸</div>
                                    <div style="color:#10b981;font-size:0.65rem"><i class="bi bi-check-circle-fill"></i> Оплачено</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="fc-stat-mini" style="background:rgba(139,92,246,0.08)">
                                    <div class="text-muted" style="font-size:0.65rem">Клиентов</div>
                                    <div class="fw-bold text-dark" style="font-size:0.9rem">47</div>
                                    <div style="color:#10b981;font-size:0.65rem"><i class="bi bi-arrow-up"></i> 5 новых</div>
                                </div>
                            </div>
                        </div>
                        <div class="fc-chart-mock">
                            <div style="display:flex;align-items:flex-end;gap:6px;height:60px">
                                @foreach (var h in new[]{30,45,35,60,50,75,55,80,65,90,70,95})
                                {
                                    <div style="flex:1;background:linear-gradient(180deg,#3B82F6,#60a5fa);border-radius:3px 3px 0 0;height:@(h)%"></div>
                                }
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                @foreach (var m in new[]{"Янв","Фев","Мар","Апр","Май","Июн","Июл","Авг","Сен","Окт","Ноя","Дек"})
                                {
                                    <span style="font-size:0.55rem;color:#9ca3af">@m</span>
                                }
                            </div>
                        </div>
                    </div>
                    <!-- Float cards -->
                    <div class="fc-float-card fc-float-1" data-aos="zoom-in" data-aos-delay="600">
                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                        <span style="font-size:0.8rem">ЭСФ отправлен</span>
                    </div>
                    <div class="fc-float-card fc-float-2" data-aos="zoom-in" data-aos-delay="800">
                        <i class="bi bi-stars text-warning me-2"></i>
                        <span style="font-size:0.8rem">ИИ проверил отчёт</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== CLIENTS STRIP ===== -->
<section class="fc-clients py-4">
    <div class="container">
        <p class="text-center text-muted small mb-4">@L["Clients.Title"]</p>
        <div class="fc-clients-strip">
            <div class="fc-clients-inner">
                @foreach (var c in new[]{"Magnum","Kaspi","Yandex Go","Halyk Bank","BCC.kz","Astana Hub","Jusan","Freedom Pay","Kolesa","1М-ный клиент"})
                {
                    <div class="fc-client-logo">@c</div>
                }
                @foreach (var c in new[]{"Magnum","Kaspi","Yandex Go","Halyk Bank","BCC.kz","Astana Hub","Jusan","Freedom Pay","Kolesa","1М-ный клиент"})
                {
                    <div class="fc-client-logo">@c</div>
                }
            </div>
        </div>
    </div>
</section>

<!-- ===== SOLUTIONS ===== -->
<section class="fc-section py-6" id="solutions">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="fc-section-badge"><i class="bi bi-lightning-fill me-2"></i>@L["Solutions.Badge"]</span>
            <h2 class="fc-section-title mt-3">@L["Solutions.Title"]</h2>
            <p class="fc-section-sub">@L["Solutions.Sub"]</p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="100">
                <div class="fc-solution-card">
                    <div class="fc-solution-icon" style="background:linear-gradient(135deg,#3B82F6,#60a5fa)">
                        <i class="bi bi-person-workspace"></i>
                    </div>
                    <h5 class="fw-bold mt-4 mb-2">@L["Sol.1.Title"]</h5>
                    <p class="text-muted small">@L["Sol.1.Desc"]</p>
                    <a href="#" class="fc-card-link mt-3 d-inline-flex align-items-center gap-1">@L["Solutions.More"] <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="200">
                <div class="fc-solution-card">
                    <div class="fc-solution-icon" style="background:linear-gradient(135deg,#10B981,#34d399)">
                        <i class="bi bi-building"></i>
                    </div>
                    <h5 class="fw-bold mt-4 mb-2">@L["Sol.2.Title"]</h5>
                    <p class="text-muted small">@L["Sol.2.Desc"]</p>
                    <a href="#" class="fc-card-link mt-3 d-inline-flex align-items-center gap-1">@L["Solutions.More"] <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="300">
                <div class="fc-solution-card">
                    <div class="fc-solution-icon" style="background:linear-gradient(135deg,#8B5CF6,#a78bfa)">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <h5 class="fw-bold mt-4 mb-2">@L["Sol.3.Title"]</h5>
                    <p class="text-muted small">@L["Sol.3.Desc"]</p>
                    <a href="#" class="fc-card-link mt-3 d-inline-flex align-items-center gap-1">@L["Solutions.More"] <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="400">
                <div class="fc-solution-card">
                    <div class="fc-solution-icon" style="background:linear-gradient(135deg,#F59E0B,#fbbf24)">
                        <i class="bi bi-shop-window"></i>
                    </div>
                    <h5 class="fw-bold mt-4 mb-2">@L["Sol.4.Title"]</h5>
                    <p class="text-muted small">@L["Sol.4.Desc"]</p>
                    <a href="#" class="fc-card-link mt-3 d-inline-flex align-items-center gap-1">@L["Solutions.More"] <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="500">
                <div class="fc-solution-card">
                    <div class="fc-solution-icon" style="background:linear-gradient(135deg,#EF4444,#f87171)">
                        <i class="bi bi-cart-check-fill"></i>
                    </div>
                    <h5 class="fw-bold mt-4 mb-2">@L["Sol.5.Title"]</h5>
                    <p class="text-muted small">@L["Sol.5.Desc"]</p>
                    <a href="#" class="fc-card-link mt-3 d-inline-flex align-items-center gap-1">@L["Solutions.More"] <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="600">
                <div class="fc-solution-card">
                    <div class="fc-solution-icon" style="background:linear-gradient(135deg,#06B6D4,#22d3ee)">
                        <i class="bi bi-bank2"></i>
                    </div>
                    <h5 class="fw-bold mt-4 mb-2">@L["Sol.6.Title"]</h5>
                    <p class="text-muted small">@L["Sol.6.Desc"]</p>
                    <a href="#" class="fc-card-link mt-3 d-inline-flex align-items-center gap-1">@L["Solutions.More"] <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== PRODUCTS ===== -->
<section class="fc-section fc-products-section py-6" id="products">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="fc-section-badge"><i class="bi bi-grid-fill me-2"></i>Продукты</span>
            <h2 class="fc-section-title mt-3">Усильте компанию с помощью<br><span class="fc-gradient-text">масштабируемых</span> инструментов</h2>
        </div>

        <ul class="nav fc-product-tabs justify-content-center mb-5" id="productTabs">
            <li class="nav-item">
                <button class="fc-tab active" data-tab="pro">
                    <i class="bi bi-box-seam me-2"></i>Z.ON Pro
                </button>
            </li>
            <li class="nav-item">
                <button class="fc-tab" data-tab="business">
                    <i class="bi bi-buildings me-2"></i>Business
                </button>
            </li>
            <li class="nav-item">
                <button class="fc-tab" data-tab="edo">
                    <i class="bi bi-file-text me-2"></i>ЭДО
                </button>
            </li>
            <li class="nav-item">
                <button class="fc-tab" data-tab="ai">
                    <i class="bi bi-stars me-2"></i>Z.ON AI
                </button>
            </li>
        </ul>

        <div id="tabPro" class="fc-tab-pane active">
            <div class="row align-items-center g-5">
                <div class="col-lg-5" data-aos="fade-right">
                    <h3 class="fw-bold mb-3">Z.ON Pro — профессиональная учётная система</h3>
                    <p class="text-muted mb-4">Автоматизирует бухгалтерию и налоги для МСБ, создаёт документы и отчётность по НСФО и НК РК, исключая ручные ошибки.</p>
                    <div class="fc-feature-list">
                        <div class="fc-feature-item"><i class="bi bi-check-circle-fill text-success"></i> Реализация: счета, ЭАВР/АВР, накладные, ЭСФ и возвраты</div>
                        <div class="fc-feature-item"><i class="bi bi-check-circle-fill text-success"></i> Отчётность и интеграция с ИС ЭСФ, eSalyq и enbek.kz</div>
                        <div class="fc-feature-item"><i class="bi bi-check-circle-fill text-success"></i> Покупки и склад: учёт номенклатуры, ОС и НМА</div>
                        <div class="fc-feature-item"><i class="bi bi-check-circle-fill text-success"></i> Банк и касса: платёжные поручения, кассовые ордера</div>
                        <div class="fc-feature-item"><i class="bi bi-check-circle-fill text-success"></i> Зарплата и кадры: приём, увольнение, расчёт и налоги</div>
                    </div>
                    <a href="/Products" class="btn fc-btn-cta mt-4">Подробнее <i class="bi bi-arrow-right ms-2"></i></a>
                </div>
                <div class="col-lg-7" data-aos="fade-left">
                    <div class="fc-product-screen">
                        <div class="fc-screen-header">
                            <div class="fc-screen-dots"><span></span><span></span><span></span></div>
                            <span class="text-muted small ms-3">Z.ON Pro — Главная</span>
                        </div>
                        <div class="fc-screen-body p-4">
                            <div class="row g-3 mb-3">
                                @foreach (var item in new[]{("Выручка","3 200 000 ₸","↑ 22%","#3B82F6"),("Налоги","320 000 ₸","↑ 11%","#10B981"),("Расходы","980 000 ₸","↓ 5%","#F59E0B")})
                                {
                                    <div class="col-4">
                                        <div class="fc-mini-stat" style="border-left:3px solid @item.Item4">
                                            <div class="text-muted" style="font-size:0.7rem">@item.Item1</div>
                                            <div class="fw-bold" style="font-size:0.85rem">@item.Item2</div>
                                            <div style="font-size:0.7rem;color:@item.Item4">@item.Item3</div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="fc-screen-row-list">
                                @foreach (var r in new[]{("ЭСФ №1042","ТОО Альфа","245 000 ₸","Отправлен"),("АВР №88","ИП Сейтов","82 000 ₸","Подписан"),("Накладная №34","Магнум","1 200 000 ₸","В работе")})
                                {
                                    <div class="fc-screen-row">
                                        <span class="text-muted small" style="flex:1">@r.Item1</span>
                                        <span class="small" style="flex:1.5">@r.Item2</span>
                                        <span class="fw-semibold small" style="flex:1.2">@r.Item3</span>
                                        <span class="fc-status-badge small">@r.Item4</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="tabBusiness" class="fc-tab-pane" style="display:none">
            <div class="row align-items-center g-5">
                <div class="col-lg-5" data-aos="fade-right">
                    <h3 class="fw-bold mb-3">Z.ON Business — автоматизация для компаний</h3>
                    <p class="text-muted mb-4">Управляйте несколькими организациями в одном интерфейсе. Идеально для аутсорсинга и холдингов.</p>
                    <div class="fc-feature-list">
                        <div class="fc-feature-item"><i class="bi bi-check-circle-fill text-success"></i> Мультиорганизационный учёт</div>
                        <div class="fc-feature-item"><i class="bi bi-check-circle-fill text-success"></i> Ролевая модель доступа</div>
                        <div class="fc-feature-item"><i class="bi bi-check-circle-fill text-success"></i> Сводная аналитика по всем компаниям</div>
                        <div class="fc-feature-item"><i class="bi bi-check-circle-fill text-success"></i> Открытый API для интеграций</div>
                    </div>
                    <a href="/Products#business" class="btn fc-btn-cta mt-4">Подробнее <i class="bi bi-arrow-right ms-2"></i></a>
                </div>
                <div class="col-lg-7" data-aos="fade-left">
                    <div class="fc-product-screen">
                        <div class="fc-screen-header">
                            <div class="fc-screen-dots"><span></span><span></span><span></span></div>
                            <span class="text-muted small ms-3">Z.ON Business — Компании</span>
                        </div>
                        <div class="fc-screen-body p-4">
                            <div class="fc-screen-row-list">
                                @foreach (var r in new[]{("ТОО «Альфа»","Алматы","Активна","↑ 12%"),("ТОО «Бета»","Астана","Активна","↑ 8%"),("ИП Сейтов","Шымкент","Активна","↑ 15%"),("ТОО «Гамма»","Алматы","Приостановлена","—")})
                                {
                                    <div class="fc-screen-row">
                                        <span class="fw-semibold small" style="flex:2">@r.Item1</span>
                                        <span class="text-muted small" style="flex:1.2">@r.Item2</span>
                                        <span class="fc-status-badge small" style="flex:1">@r.Item3</span>
                                        <span class="small" style="flex:0.8;color:#10b981">@r.Item4</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="tabEdo" class="fc-tab-pane" style="display:none">
            <div class="row align-items-center g-5">
                <div class="col-lg-5" data-aos="fade-right">
                    <h3 class="fw-bold mb-3">Z.ON ЭДО — электронный документооборот</h3>
                    <p class="text-muted mb-4">Отправляйте и принимайте ЭСФ, ЭАВР, накладные напрямую через ИС ЭСФ. Никаких ручных загрузок.</p>
                    <div class="fc-feature-list">
                        <div class="fc-feature-item"><i class="bi bi-check-circle-fill text-success"></i> Интеграция с ИС ЭСФ и КПН</div>
                        <div class="fc-feature-item"><i class="bi bi-check-circle-fill text-success"></i> Автоматическое подписание ЭЦП</div>
                        <div class="fc-feature-item"><i class="bi bi-check-circle-fill text-success"></i> Уведомления о статусах в реальном времени</div>
                        <div class="fc-feature-item"><i class="bi bi-check-circle-fill text-success"></i> Архив всех документов онлайн</div>
                    </div>
                    <a href="/Products#edo" class="btn fc-btn-cta mt-4">Подробнее <i class="bi bi-arrow-right ms-2"></i></a>
                </div>
                <div class="col-lg-7" data-aos="fade-left">
                    <div class="fc-product-screen">
                        <div class="fc-screen-header">
                            <div class="fc-screen-dots"><span></span><span></span><span></span></div>
                            <span class="text-muted small ms-3">Z.ON ЭДО — Документы</span>
                        </div>
                        <div class="fc-screen-body p-4 d-flex flex-column gap-2">
                            @foreach (var d in new[]{("ЭСФ","Исходящий","ТОО Альфа","Доставлен","#10b981"),("ЭАВР","Входящий","ИП Нуров","Подписан","#3b82f6"),("Накладная","Исходящий","Kaspi","Ожидает","#f59e0b")})
                            {
                                <div class="fc-edo-row d-flex align-items-center gap-3 p-2 rounded-2" style="background:#f8faff">
                                    <span class="fw-bold" style="color:@d.Item5;min-width:50px">@d.Item1</span>
                                    <span class="text-muted small" style="flex:1">@d.Item2 · @d.Item3</span>
                                    <span class="badge rounded-pill" style="background:@d.Item5+'22';color:@d.Item5">@d.Item4</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="tabAi" class="fc-tab-pane" style="display:none">
            <div class="row align-items-center g-5">
                <div class="col-lg-5" data-aos="fade-right">
                    <h3 class="fw-bold mb-3">Z.ON AI — первый ИИ-бухгалтер в Казахстане</h3>
                    <p class="text-muted mb-4">Задавайте вопросы на русском или казахском — ИИ ответит, найдёт ошибки и подготовит отчёт за секунды.</p>
                    <div class="fc-feature-list">
                        <div class="fc-feature-item"><i class="bi bi-check-circle-fill text-success"></i> Автопроверка первичных документов</div>
                        <div class="fc-feature-item"><i class="bi bi-check-circle-fill text-success"></i> Налоговый советник 24/7</div>
                        <div class="fc-feature-item"><i class="bi bi-check-circle-fill text-success"></i> Автозаполнение деклараций</div>
                        <div class="fc-feature-item"><i class="bi bi-check-circle-fill text-success"></i> Умный поиск по документам</div>
                    </div>
                    <a href="/Products#ai" class="btn fc-btn-cta mt-4">Попробовать AI <i class="bi bi-stars ms-2"></i></a>
                </div>
                <div class="col-lg-7" data-aos="fade-left">
                    <div class="fc-product-screen fc-ai-screen">
                        <div class="fc-screen-header">
                            <div class="fc-screen-dots"><span></span><span></span><span></span></div>
                            <span class="text-muted small ms-3">Z.ON AI</span>
                        </div>
                        <div class="fc-screen-body p-4">
                            <div class="fc-chat-msg fc-chat-user">Когда нужно сдавать форму 910?</div>
                            <div class="fc-chat-msg fc-chat-ai">
                                <i class="bi bi-stars text-primary me-2"></i>
                                Форма 910 (упрощённая декларация) сдаётся <strong>два раза в год</strong>: за первое полугодие — до 15 августа, за второе — до 15 февраля следующего года. Хотите напомнить?
                            </div>
