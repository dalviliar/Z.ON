@page
@model ContactsModel
@{
    ViewData["Title"] = "Контакты";
}

<section class="fc-contacts-hero">
    <div class="container text-center" data-aos="fade-up">
        <span class="fc-section-badge mb-4"><i class="bi bi-telephone-fill me-2"></i>Контакты</span>
        <h1 class="fc-section-title mt-3">Свяжитесь <span class="fc-gradient-text">с нами</span></h1>
        <p class="fc-section-sub mt-3 mx-auto">Получите поддержку и доступ к инструментам для эффективного ведения бизнеса.</p>
    </div>
</section>

<section class="py-6">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-5" data-aos="fade-right">
                <h3 class="fw-bold mb-4">Контактная информация</h3>
                <div class="d-flex flex-column gap-3 mb-5">
                    <div class="fc-contact-card">
                        <div class="fc-contact-icon"><i class="bi bi-telephone-fill"></i></div>
                        <div>
                            <div class="fw-semibold small text-muted">Телефон</div>
                            <a href="tel:+77013218808" class="text-dark text-decoration-none fw-semibold">+7 701 321 88 08</a>
                        </div>
                    </div>
                    <div class="fc-contact-card">
                        <div class="fc-contact-icon" style="background:rgba(16,185,129,0.08);color:#10b981"><i class="bi bi-envelope-fill"></i></div>
                        <div>
                            <div class="fw-semibold small text-muted">Email</div>
                            <a href="mailto:hello@fincore.kz" class="text-dark text-decoration-none fw-semibold">hello@fincore.kz</a>
                        </div>
                    </div>
                    <div class="fc-contact-card">
                        <div class="fc-contact-icon" style="background:rgba(139,92,246,0.08);color:#8B5CF6"><i class="bi bi-geo-alt-fill"></i></div>
                        <div>
                            <div class="fw-semibold small text-muted">Адрес</div>
                            <span class="text-dark fw-semibold">г. Алматы, пр. Аль-Фараби 17</span>
                        </div>
                    </div>
                    <div class="fc-contact-card">
                        <div class="fc-contact-icon" style="background:rgba(245,158,11,0.08);color:#F59E0B"><i class="bi bi-clock-fill"></i></div>
                        <div>
                            <div class="fw-semibold small text-muted">Часы работы</div>
                            <span class="text-dark fw-semibold">Пн–Пт: 9:00 – 18:00</span>
                        </div>
                    </div>
                </div>

                <h5 class="fw-bold mb-3">Мессенджеры</h5>
                <div class="d-flex gap-2">
                    <a href="#" class="btn btn-outline-secondary rounded-3 d-flex align-items-center gap-2 px-3">
                        <i class="bi bi-telegram text-primary"></i> Telegram
                    </a>
                    <a href="#" class="btn btn-outline-secondary rounded-3 d-flex align-items-center gap-2 px-3">
                        <i class="bi bi-whatsapp text-success"></i> WhatsApp
                    </a>
                </div>
            </div>

            <div class="col-lg-7" data-aos="fade-left">
                <div class="fc-form-card">
                    <h3 class="fw-bold mb-1">Отправить сообщение</h3>
                    <p class="text-muted small mb-4">Среднее время ответа — <strong>3 минуты</strong></p>

                    <form id="contactForm" asp-antiforgery="true">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold small">Имя *</label>
                                <input name="Name" type="text" class="fc-input" placeholder="Ваше имя" required>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold small">Телефон</label>
                                <input name="Phone" type="tel" class="fc-input" placeholder="+7 (___) ___-__-__">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Email *</label>
                                <input name="Email" type="email" class="fc-input" placeholder="example@mail.kz" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Компания</label>
                                <input name="Company" type="text" class="fc-input" placeholder="Название вашей компании">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Сообщение *</label>
                                <textarea name="Message" class="fc-input" rows="4" placeholder="Расскажите о вашем бизнесе и задачах..." required style="resize:vertical"></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn fc-btn-cta w-100 py-3 fs-6">
                                    Отправить сообщение <i class="bi bi-send ms-2"></i>
                                </button>
                                <p class="text-muted text-center mt-3 small">Нажимая кнопку, вы соглашаетесь с <a href="#" class="text-primary">политикой конфиденциальности</a></p>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5" style="background:#f8faff">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h3 class="fw-bold">Часто выбирают <span class="fc-gradient-text">начало здесь</span></h3>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="text-center p-4 rounded-4" style="background:white;border:1.5px solid rgba(59,130,246,0.1)">
                    <div style="width:52px;height:52px;background:rgba(59,130,246,0.08);border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-size:1.4rem;color:#3B82F6"><i class="bi bi-play-circle-fill"></i></div>
                    <h6 class="fw-bold mb-2">Запросить демо</h6>
                    <p class="text-muted small mb-3">Живая демонстрация продукта с нашим специалистом</p>
                    <a href="#" class="btn fc-btn-price-outline w-100">Записаться</a>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="text-center p-4 rounded-4" style="background:linear-gradient(135deg,#eff6ff,#f5f3ff);border:1.5px solid rgba(59,130,246,0.2)">
                    <div style="width:52px;height:52px;background:rgba(59,130,246,0.1);border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-size:1.4rem;color:#3B82F6"><i class="bi bi-gift-fill"></i></div>
                    <h6 class="fw-bold mb-2">14 дней бесплатно</h6>
                    <p class="text-muted small mb-3">Полный доступ ко всем функциям без карты</p>
                    <a href="#" class="btn fc-btn-cta w-100">Начать сейчас</a>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
                <div class="text-center p-4 rounded-4" style="background:white;border:1.5px solid rgba(59,130,246,0.1)">
                    <div style="width:52px;height:52px;background:rgba(16,185,129,0.08);border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-size:1.4rem;color:#10B981"><i class="bi bi-headset"></i></div>
                    <h6 class="fw-bold mb-2">Поговорить со специалистом</h6>
                    <p class="text-muted small mb-3">Бесплатная консультация по подбору тарифа</p>
                    <a href="tel:+77013218808" class="btn fc-btn-price-outline w-100" style="color:#10B981 !important;border-color:#10B981 !important">Позвонить</a>
                </div>
            </div>
        </div>
    </div>
</section>
